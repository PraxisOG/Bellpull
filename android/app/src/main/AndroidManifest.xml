<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <uses-permission android:name="android.permission.INTERNET" />

    <!--
      App enumeration scoped to exactly what the search bar needs: activities that answer
      ACTION_MAIN + CATEGORY_LAUNCHER, i.e. the things a user could launch anyway.

      Deliberately NOT QUERY_ALL_PACKAGES, which is broader than needed, returns system
      packages we would immediately filter back out, and is a permission Play treats as
      sensitive. This <queries> form needs no permission at all.
    -->
    <queries>
        <intent>
            <action android:name="android.intent.action.MAIN" />
            <category android:name="android.intent.category.LAUNCHER" />
        </intent>
    </queries>

    <application
        android:allowBackup="false"
        android:label="Hermes"
        android:theme="@style/Theme.Hermes"
        android:supportsRtl="true"
        android:usesCleartextTraffic="true">
        <activity
            android:name=".MainActivity"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <receiver
            android:name=".HermesWidgetReceiver"
            android:exported="true">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/hermes_widget_info" />
        </receiver>
    </application>
</manifest>
