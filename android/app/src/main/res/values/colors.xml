    <color name="launcher_background">#FF59091E</color>
    <!--
      Widget colours live in resources rather than in Kotlin because Glance 1.2.0 has no
      day/night ColorProvider overload — the resource system is the mechanism. That also keeps
      the app's "no hardcoded colours anywhere" property intact.

      The widget host renders outside this app's Compose theme and cannot inherit one.
      Keep these day/night values aligned with HermesTheme's primary container colours.
    -->
    <color name="widget_background">#FFD9EDE5</color>
    <color name="widget_on_background">#FF143E37</color>
</resources>
